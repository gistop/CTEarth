# Optional API base URL for future backend services.
# VITE_API_BASE_URL=https://api.example.com

# Optional MapLibre style URL for a production basemap.
# Leave empty to use the built-in OpenStreetMap raster tile style.
# VITE_MAP_STYLE_URL=

# Optional Cesium ion token for Bing / World Terrain / ion imagery.
# VITE_CESIUM_ION_TOKEN=
VITE_AI_CHAT_API=/api/chat
